<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.silveira</groupId>
  <artifactId>selenium-automation-framework</artifactId>
  <version>1.0.0</version>
  <name>selenium-automation-framework</name>
  <description>Framework de automatizacion reutilizable sobre Selenium 4</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <selenium.version>4.33.0</selenium.version>
    <testng.version>7.10.2</testng.version>
    <cucumber.version>7.22.1</cucumber.version>
    <extentreports.version>5.1.2</extentreports.version>
    <allure.version>2.29.0</allure.version>
    <log4j.version>2.24.1</log4j.version>
    <poi.version>5.3.0</poi.version>
    <jackson.version>2.18.1</jackson.version>
    <datafaker.version>2.4.0</datafaker.version>
    <assertj.version>3.26.3</assertj.version>
    <restassured.version>5.5.0</restassured.version>
    <testcontainers.version>1.21.3</testcontainers.version>
    <postgresql.version>42.7.7</postgresql.version>
    <hikari.version>6.3.0</hikari.version>
    <axe.version>4.10.1</axe.version>
    <angusmail.version>2.0.3</angusmail.version>
    <greenmail.version>2.1.3</greenmail.version>

    <suiteXmlFile>src/test/resources/suites/regression.xml</suiteXmlFile>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
    </dependency>

    <dependency>
      <groupId>com.aventstack</groupId>
      <artifactId>extentreports</artifactId>
      <version>${extentreports.version}</version>
    </dependency>
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <version>${allure.version}</version>
    </dependency>
    <!-- Necesaria para el plugin AllureCucumber7Jvm que declara el runner: sin
         ella el runner falla al arrancar con ClassNotFoundException. -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-cucumber7-jvm</artifactId>
      <version>${allure.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>net.datafaker</groupId>
      <artifactId>datafaker</artifactId>
      <version>${datafaker.version}</version>
    </dependency>

    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-testng</artifactId>
      <version>${cucumber.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>${cucumber.version}</version>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
    </dependency>

    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${restassured.version}</version>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${restassured.version}</version>
      <!-- Arrastra com.sun.mail:mailapi, de la era javax.mail, que choca con el
           jakarta.mail de las notificaciones. Excluirlo parece lo obvio y no se
           puede: json-schema-validator inicializa su tabla de formatos de golpe y
           uno de ellos referencia javax.mail.internet, asi que sin el jar toda
           validacion contra JSON Schema muere con NoClassDefFoundError. La
           convivencia se resuelve en EmailNotifier, no aca. -->
    </dependency>

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <!-- Solo para la suite de base de datos: levanta un Postgres real y
         descartable. Requiere Docker, por eso esa suite corre aparte. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
    </dependency>

    <!-- axe-core: el mismo motor que usan las extensiones de navegador y los
         lectores de auditoria. Escribir las reglas WCAG a mano no es una opcion. -->
    <dependency>
      <groupId>com.deque.html.axe-core</groupId>
      <artifactId>selenium</artifactId>
      <version>${axe.version}</version>
    </dependency>

    <!-- SMTP para las notificaciones. angus-mail arrastra jakarta.mail-api. -->
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>${angusmail.version}</version>
    </dependency>
    <!-- Servidor SMTP en memoria: permite verificar que el mail sale de verdad
         sin depender de una casilla real ni de la red. -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <version>${greenmail.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Sin testFailureIgnore: si falla un test, falla el build. -->
          <suiteXmlFiles>
            <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
          </suiteXmlFiles>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>2.15.2</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Camino opcional: corre los features de Cucumber sobre el mismo framework. -->
    <profile>
      <id>cucumber</id>
      <properties>
        <suiteXmlFile>src/test/resources/suites/cucumber.xml</suiteXmlFile>
      </properties>
    </profile>
  </profiles>
</project>
