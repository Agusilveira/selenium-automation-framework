<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- La unica suite donde interfaz, API y base son del mismo sistema. Requiere la
     aplicacion levantada:
       docker compose -f docker-compose.app.yml up -d && ./scripts/preparar-app.sh -->
<suite name="Aplicacion propia" verbose="1">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
        <listener class-name="com.silveira.listeners.SoftFailureListener"/>
        <listener class-name="com.silveira.listeners.FallbackGuardListener"/>
    </listeners>

    <test name="Cruce entre capas">
        <packages>
            <package name="com.silveira.projects.app.tests"/>
        </packages>
    </test>
</suite>
