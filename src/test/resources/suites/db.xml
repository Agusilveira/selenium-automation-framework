<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Suite aparte: requiere Docker, a diferencia del resto. Por eso 'mvn test'
     sigue funcionando sin el, y la promesa de clonar y correr se mantiene. -->
<suite name="Base de datos" verbose="1">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
        <listener class-name="com.silveira.listeners.SoftFailureListener"/>
    </listeners>

    <test name="Tienda">
        <packages>
            <package name="com.silveira.projects.tienda.tests"/>
        </packages>
    </test>
</suite>
