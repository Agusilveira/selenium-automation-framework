<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Un navegador por metodo: cada caso arranca limpio y corren de a varios.
     Es donde el ThreadLocal de DriverManager se gana el lugar. -->
<suite name="Paralelo" verbose="1" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="SauceDemo en paralelo">
        <groups>
            <run><include name="regresion"/></run>
        </groups>
        <packages>
            <package name="com.silveira.projects.saucedemo.tests"/>
        </packages>
    </test>
</suite>
