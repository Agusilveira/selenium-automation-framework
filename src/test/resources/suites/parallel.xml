<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Un navegador por metodo: cada caso arranca limpio y corren de a varios.
     Es donde el ThreadLocal de DriverManager se gana el lugar. -->
<suite name="Paralelo" verbose="1" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
        <listener class-name="com.silveira.listeners.SoftFailureListener"/>
        <listener class-name="com.silveira.listeners.FallbackGuardListener"/>
    </listeners>

    <test name="SauceDemo en paralelo">
        <groups>
            <run><include name="regresion"/></run>
        </groups>
        <packages>
            <package name="com.silveira.projects.saucedemo.tests"/>
            <package name="com.silveira.projects.theinternet.tests"/>
        </packages>
    </test>

    <!-- Ultimo a proposito: mide el total de la corrida, asi que necesita correr
         despues de todo lo demas. Los bloques <test> se ejecutan en orden. -->
    <test name="Guardias del framework">
        <classes>
            <class name="com.silveira.guards.FallbackGuardTest"/>
        </classes>
    </test>
</suite>
