<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regresion" verbose="1">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Unitarios del framework">
        <packages>
            <package name="com.silveira.config"/>
            <package name="com.silveira.helpers"/>
            <package name="com.silveira.utils"/>
        </packages>
    </test>

    <test name="SauceDemo">
        <groups>
            <run><include name="regresion"/></run>
        </groups>
        <packages>
            <package name="com.silveira.projects.saucedemo.tests"/>
        </packages>
    </test>
</suite>
