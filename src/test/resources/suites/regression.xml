<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regresion" verbose="1">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.AnnotationTransformer"/>
        <listener class-name="com.silveira.listeners.SoftFailureListener"/>
        <listener class-name="com.silveira.listeners.FallbackGuardListener"/>
        <!-- Avisa por mail al terminar. Sin MAIL_SMTP_HOST en el entorno no hace
             nada, asi que un clone limpio corre igual. -->
        <listener class-name="com.silveira.listeners.NotificacionListener"/>
    </listeners>

    <test name="Unitarios del framework">
        <packages>
            <package name="com.silveira.a11y"/>
            <package name="com.silveira.config"/>
            <package name="com.silveira.helpers"/>
            <package name="com.silveira.notifications"/>
            <package name="com.silveira.utils"/>
        </packages>
    </test>

    <test name="SauceDemo">
        <groups>
            <run><include name="regresion"/></run>
        </groups>
        <packages>
            <package name="com.silveira.projects.saucedemo.tests"/>
            <package name="com.silveira.projects.theinternet.tests"/>
        </packages>
    </test>

    <!-- Ultimo a proposito: mide el total de la corrida, asi que necesita correr
         despues de todo lo demas. Los bloques <test> se ejecutan en orden. -->
    <test name="Guardias del framework">
        <classes>
            <class name="com.silveira.guards.FallbackGuardTest"/>
        </classes>
    </test>
</suite>
