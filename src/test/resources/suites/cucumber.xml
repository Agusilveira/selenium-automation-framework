<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cucumber" verbose="1">

    <listeners>
        <listener class-name="com.silveira.listeners.TestListener"/>
        <listener class-name="com.silveira.listeners.SoftFailureListener"/>
        <listener class-name="com.silveira.listeners.FallbackGuardListener"/>
    </listeners>

    <test name="Features sobre el mismo framework">
        <classes>
            <class name="com.silveira.cucumber.runners.CucumberRunner"/>
        </classes>
    </test>

    <!-- Ultimo a proposito: mide el total de la corrida, asi que necesita correr
         despues de todo lo demas. Los bloques <test> se ejecutan en orden. -->
    <test name="Guardias del framework">
        <classes>
            <class name="com.silveira.guards.FallbackGuardTest"/>
        </classes>
    </test>
</suite>
